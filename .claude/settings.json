{
  "permissions": {
    "allow": [
      "mcp__artemis",
      "Bash(./gradlew:*)",
      "Bash(./gradlew.bat:*)",
      "Bash(bash scripts/ci-local.sh:*)",
      "Bash(bash .agents/skills/android-device-test/scripts/dev.sh:*)",
      "Bash(adb devices:*)",
      "Bash(adb logcat:*)",
      "Bash(adb shell screencap:*)",
      "Bash(adb pull:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api user:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin master)",
      "Bash(git push -u origin master)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr review --approve:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/route-prompt.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/check-done.sh\""
          }
        ]
      }
    ]
  }
}